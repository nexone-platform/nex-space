# Copy to .env on the relay machine and fill in the secret.
#
#   cp .env.example .env

# The same string as TURN_SECRET on the app server. Nothing works if they differ,
# and the failure looks like the relay being unreachable rather than wrong.
#   openssl rand -hex 32
TURN_SECRET=

# Shown in the authentication challenge. Any name; it is not a hostname.
TURN_REALM=nexspace

# ---- everything below is optional ------------------------------------------

# Only if THIS machine is behind NAT too. On a VPS holding its own public
# address, leave both blank — coturn finds the address by itself.
#TURN_LISTEN_IP=
#TURN_EXTERNAL_IP=

# TLS, so a firewall that allows nothing but 443 still lets calls through. Needs
# a certificate for the name this machine answers to — see README.md.
#TURN_TLS_PORT=443
#TURN_CERT=/certs/live/turn.example.com/fullchain.pem
#TURN_KEY=/certs/live/turn.example.com/privkey.pem

# Where the certificates live on the host. The default suits certbot.
#TURN_CERT_DIR=/etc/letsencrypt

# The relay's own ports. Change only if something else on this machine wants
# them — and open whatever you change on the firewall.
#TURN_PORT=3478
#TURN_MIN_PORT=49160
#TURN_MAX_PORT=49260
