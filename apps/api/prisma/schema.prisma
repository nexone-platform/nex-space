// Dev uses SQLite (zero-setup, runnable now). For production switch to PostgreSQL:
//   provider = "postgresql"   and   DATABASE_URL="postgresql://user:pass@host:5432/nexspace"
// Fields are portable (JSON stored as String) so no schema rewrite is needed.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  name          String
  passwordHash  String? // null for accounts created via email code / Google
  googleId      String?      @unique
  photoUrl      String? // Google profile picture
  role          String? // onboarding: Founder / Director / Manager / ...
  // What a colleague would want to know before saying hello. A space like this
  // is used to find out who someone is, and a name over an avatar does not say.
  bio           String? // a sentence or two, written by them
  team          String? // the department or squad they sit with
  timezone      String? // IANA name, so "is it their morning" is answerable
  companySize   String? // onboarding: "1-10", "11-50", ...
  // authenticator app (TOTP). The secret exists from the moment setup starts;
  // totpEnabledAt is what makes it required at sign-in.
  totpSecret    String?
  totpEnabledAt DateTime?
  totpLastStep  Int? // last spent 30s step, so a seen code can't be replayed
  recoveryCodes String? // JSON array of bcrypt hashes, one per unused code
  avatar        String? // JSON string: { avatarId, skin, hair, top, ... }
  desk          String? // JSON string: { workspaceSlug: deskId }
  createdAt     DateTime     @default(now())
  lastSeenAt    DateTime? // refreshed at most every few minutes — powers "Last Active"
  sessions      Session[]
  maps          SavedMap[]
  owned         Workspace[]  @relation("OwnedWorkspaces")
  memberships   Membership[]
  sent          Message[]    @relation("MessagesSent")
  booked        Booking[]    @relation("BookingsHosted")
  invitesSent   Invite[]     @relation("InvitesSent")
  goingTo       BookingGoing[]
  received      Message[]    @relation("MessagesReceived")
  dmReads       DmRead[]
  visits        Visit[]
}

// A company / community space. People join via its invite code; the owner
// decides whether people without an account (guests) may enter.
model Workspace {
  id          String         @id @default(cuid())
  slug        String         @unique // used in ?w=<slug> and as the room key
  name        String // display name, e.g. "บริษัท A"
  inviteCode  String         @unique
  allowGuests Boolean        @default(true)
  // map layout everyone in this space loads. Per workspace, not per person:
  // different maps would put people inside each other's walls.
  theme       String         @default("classic")
  useCase     String? // onboarding: how the team plans to use this space
  // Opens this space's .ics feed, and nothing else. Its own secret rather than
  // the invite code, so a space can hand a calendar to a contractor without
  // handing them the door — and can take it back by rotating this alone.
  // Made on first use: a space that never opens a calendar never has one.
  calendarKey String?
  ownerId     String
  owner       User           @relation("OwnedWorkspaces", fields: [ownerId], references: [id], onDelete: Cascade)
  members     Membership[]
  guests      GuestPass[]
  messages    Message[]
  attachments Attachment[]
  bookings    Booking[]
  invites     Invite[]
  maps        WorkspaceMap[]
  visits      Visit[]
  createdAt   DateTime       @default(now())
}

// The layout this space actually loads, when it is not one of the three built
// into the client. `theme` above still names the stock map to fall back to, so
// deleting this row puts the space back on a known-good world rather than on
// nothing at all.
//
// Stored as a JSON string, validated against src/mapValidate.ts before it is
// written — a map reaches every browser in the space, so a bad one is not a bad
// record, it is a room nobody can walk into.
model WorkspaceMap {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // The map's own id, mirroring `id` inside `data` and the ?m= in the URL. A
  // space may hold several — floors of a building, or separate offices — and
  // this is what a portal names when it sends somebody to another one.
  slug        String    @default("main")
  // Lowest first. The landing map is simply the first, so "which one do people
  // arrive on" is answered by dragging rather than by a second flag that can
  // disagree with itself.
  order       Int       @default(0)
  data        String
  updatedById String?
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, slug])
}

// A named pass that lets one visitor in without an account, listed under
// "จัดการแขก". Distinct from allowGuests, which is an open door nobody can
// account for: a pass names its holder, can expire, and revoking it shuts that
// one visitor out without closing the space to anyone else.
model GuestPass {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String // who it was issued to
  code        String    @unique // the ?g= in the guest link
  note        String?
  expiresAt   DateTime? // null = no expiry
  revokedAt   DateTime?
  archivedAt  DateTime? // hidden from the default list, kept for the record
  lastSeenAt  DateTime? // stamped when the pass is used to enter
  visits      Int       @default(0)
  createdById String? // the member who issued it
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}

model Membership {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        String    @default("member") // owner | admin | member | guest
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, workspaceId])
}

// One-time 6-digit sign-in codes emailed to the user. Stored hashed, single use.
model LoginCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Session {
  token        String   @id
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  // issued after the first factor but before the authenticator code. Such a token
  // is accepted only by /auth/totp/verify — requireAuth rejects it.
  pendingTotp  Boolean  @default(false)
  totpAttempts Int      @default(0) // brute-force guard on the 6-digit step
}

model SavedMap {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  data      String // Tiled/JSON map data as string
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One line of room chat, kept so that a refresh does not erase what was said.
//
// The author's name is copied in rather than read from the account: guests have
// no account at all, and a member who later changes their display name should
// not silently rewrite what everyone remembers reading. userId is kept as well,
// so a person's own messages can still be found after a rename.
model Message {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation("MessagesSent", fields: [userId], references: [id], onDelete: SetNull)
  // Null means the room. Set means this line was meant for one person, and the
  // room must never be shown it — every room query filters on this being null,
  // and the one that forgets is the one that publishes a private conversation.
  toUserId    String?
  to          User?     @relation("MessagesReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  authorName  String
  body        String
  // A message can be a file with nothing said about it, which is why body is
  // allowed to be empty when this is set. One file per line, not many: a list
  // of files is a conversation about several things, and threading it to a
  // single line makes the reply ambiguous.
  attachId    String?
  attach      Attachment? @relation(fields: [attachId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  // the room reads "the newest N here", a thread reads "the newest N between
  // these two" — different questions, so different indexes
  @@index([workspaceId, createdAt])
  @@index([workspaceId, toUserId, createdAt])
}

// Somebody asked to join, by name, who has not arrived yet.
//
// Different from the workspace's invite code in one way that matters: that code
// is a door anybody holding it can walk through, and it says nothing about who
// was expected. This is addressed to one email, single use, and it expires — so
// "who have we asked, and who has not answered" is a question with an answer.
//
// The token is what the emailed link carries. Redeeming it requires being
// signed in as that email: an invitation addressed to one person that anybody
// forwarded could use would be the invite code again, wearing a name.
model Invite {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  // The role they get on arrival. An admin may invite an admin; the API applies
  // the same ceiling it applies to changing somebody's role.
  role        String    @default("member")
  token       String    @unique
  // who asked, kept as a name as well: the row outlives the account
  invitedById String?
  invitedBy   User?     @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedByName String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  // when the email actually went. Null means it was never sent — no SMTP
  // configured — and the link has to be handed over some other way.
  sentAt      DateTime?

  // one live invitation per address per space; a second ask reuses the row
  @@unique([workspaceId, email])
  @@index([workspaceId, createdAt])
}

// A room, held for a while.
//
// The room is named by (mapSlug, roomId) rather than by a row of its own,
// because rooms are drawn on maps and a map can be redrawn. Deleting a room
// from a map should not orphan a foreign key; it should leave a booking for a
// room that is no longer there, which reads correctly and clears itself when
// the time passes.
//
// roomLabel is a snapshot for the same reason. Renaming "ห้องประชุม" to
// "ห้องประชุมเล็ก" should not rewrite what last month's meetings say they were
// in.
model Booking {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mapSlug     String    @default("main")
  roomId      String
  roomLabel   String
  title       String
  // The person who booked it. Null once their account is gone — the meeting
  // still happened, and hostName is what anybody reading it needs.
  userId      String?
  host        User?     @relation("BookingsHosted", fields: [userId], references: [id], onDelete: SetNull)
  hostName    String
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime  @default(now())
  going       BookingGoing[]

  // "what is on today" and "is this room free then" are different questions
  @@index([workspaceId, startsAt])
  @@index([workspaceId, mapSlug, roomId, startsAt])
}

// Somebody who said they are coming.
//
// Not an invitation — nobody is added by anybody else. It exists so a reminder
// has somewhere to go: without it the only person a meeting could remind is the
// one who booked it, who is the least likely to have forgotten.
model BookingGoing {
  bookingId String
  userId    String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  at        DateTime @default(now())

  @@id([bookingId, userId])
  @@index([userId])
}

// A file somebody put in the chat.
//
// The bytes live on disk, not in this row. SQLite would hold them happily and
// then every listing that touches a message would drag the file through Prisma
// to render a filename — the row is the catalogue card, the volume is the shelf.
//
// It is deliberately not deleted when the message that showed it is: the sweep
// that trims old chat removes both, together, so that "the file is gone but the
// line still mentions it" is not a state this can be in.
model Attachment {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // who uploaded it. Null for a guest, who has no account to attribute it to,
  // and null again once an account is deleted — the file stays because the
  // conversation it belongs to does.
  userId      String?
  name        String    // as they named it, minus anything that is a path
  mime        String    // what we will serve it as, from the allowlist only
  bytes       Int
  // Only ever a layout hint, and only for images: it reserves the right space
  // before the file has loaded. Sent by the browser that uploaded it, so it is
  // clamped rather than trusted.
  width       Int?
  height      Int?
  path        String    // relative to the uploads root, so the root can move
  createdAt   DateTime  @default(now())
  messages    Message[]

  @@index([workspaceId, createdAt])
}

// How far one person has read another's private messages.
//
// Kept on the server rather than in the browser so the count is the same on a
// phone as on a desktop: an unread badge only one machine knows about is a badge
// that is wrong everywhere else.
model DmRead {
  workspaceId String
  userId      String
  peerId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt      DateTime @default(now())

  @@id([workspaceId, userId, peerId])
}

// One person's stay in a space: when they arrived, when they left, and where
// they spent it. Written by the room server using the credential that opened
// the door, the same way a chat line is — so there is no second secret between
// the two services and no way to log a visit to a space you cannot enter.
//
// A visit that never closes is a session the server lost (a crash, a killed
// process). Those are counted as arrivals and excluded from any total of time,
// because guessing how long somebody stayed is worse than saying we do not know.
model Visit {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Null for a guest: there is no account to point at, which is also what makes
  // "how many of our own people used it" answerable.
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  // the name they were showing at the time — a pass holder has no account to
  // look one up from later, and a member may since have renamed themselves
  name        String
  guest       Boolean   @default(false)
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?
  // seconds per "map/areaId", "map/" being that map's open floor. JSON rather
  // than a row per area: it is written once, read in bulk, and never queried
  // across visits by area — the dashboard sums it in memory.
  areas       String?

  @@index([workspaceId, joinedAt])
}
