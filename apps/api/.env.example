# Copy to apps/api/.env for local development (docker-compose sets these itself).
# Prisma resolves a relative SQLite path against the schema folder, so this
# lands at apps/api/prisma/dev.db. The Prisma CLI reads DATABASE_URL from here.
DATABASE_URL="file:./dev.db"

# --- Google sign-in (optional) ---
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3001/auth/google/callback   (dev)
#                          https://<your-host>/auth/google/callback     (prod)
# Leave blank and the "Continue with Google" button hides itself.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- SMTP for the 6-digit sign-in code (optional) ---
# Leave blank and codes are printed to the API log instead of emailed.
# Gmail needs an App Password (not your normal password).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="NexSpace <no-reply@example.com>"

# --- Where the app is served (optional in production) ---
# Links that leave this server — the ones in invitation emails and the calendar
# feed address — have to point at the APP, not at this API. In production nginx
# serves both on one host and it is derived correctly from the request. In
# development they are two ports, so say it explicitly or invite links come out
# pointing at :3001 where there is no app to open them.
APP_URL="http://localhost:5173"

# --- Files in the chat (optional) ---
# Where uploads are written. Defaults to apps/api/data/uploads, which is the
# path the production volume mounts over.
UPLOAD_DIR=""
UPLOAD_MAX_BYTES="10000000"
# Signs the short-lived links that open a file. Blank generates one and keeps it
# beside the uploads, which is right for a single API process.
UPLOAD_SECRET=""

# --- Sending mail over HTTPS instead of SMTP (optional, and usually easier) ---
# Set this and the SMTP settings above are ignored. Use it when the host blocks
# outbound SMTP, which is common — test with:
#   timeout 10 bash -c 'cat < /dev/null > /dev/tcp/smtp.resend.com/587'
RESEND_API_KEY=""
# The From address, either way. MAIL_FROM is the name that still makes sense
# when the transport is not SMTP; SMTP_FROM above is still honoured.
MAIL_FROM=""

# --- Invitations by email (optional) ---
INVITE_DAYS="14"
INVITE_KEEP_DAYS="90"

# --- Room bookings (optional) ---
BOOKING_MAX_MINUTES="480"
BOOKING_MAX_DAYS="90"
BOOKING_KEEP_DAYS="120"
