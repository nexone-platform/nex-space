# Copy to apps/api/.env for local development (docker-compose sets these itself).
# Prisma resolves a relative SQLite path against the schema folder, so this
# lands at apps/api/prisma/dev.db. The Prisma CLI reads DATABASE_URL from here.
DATABASE_URL="file:./dev.db"

# --- Google sign-in (optional) ---
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3001/auth/google/callback   (dev)
#                          https://<your-host>/auth/google/callback     (prod)
# Leave blank and the "Continue with Google" button hides itself.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- SMTP for the 6-digit sign-in code (optional) ---
# Leave blank and codes are printed to the API log instead of emailed.
# Gmail needs an App Password (not your normal password).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="NexSpace <no-reply@example.com>"

# --- Where the app is served (optional in production) ---
# Links that leave this server — the ones in invitation emails and the calendar
# feed address — have to point at the APP, not at this API. In production nginx
# serves both on one host and it is derived correctly from the request. In
# development they are two ports, so say it explicitly or invite links come out
# pointing at :3001 where there is no app to open them.
APP_URL="http://localhost:5173"

# --- Files in the chat (optional) ---
# Where uploads are written. Defaults to apps/api/data/uploads, which is the
# path the production volume mounts over.
UPLOAD_DIR=""
UPLOAD_MAX_BYTES="10000000"
# Signs the short-lived links that open a file. Blank generates one and keeps it
# beside the uploads, which is right for a single API process.
UPLOAD_SECRET=""

# --- Sending mail over HTTPS instead of SMTP (optional, and usually easier) ---
# Set this and the SMTP settings above are ignored. Use it when the host blocks
# outbound SMTP, which is common — test with:
#   timeout 10 bash -c 'cat < /dev/null > /dev/tcp/smtp.resend.com/587'
RESEND_API_KEY=""
# The From address, either way. MAIL_FROM is the name that still makes sense
# when the transport is not SMTP; SMTP_FROM above is still honoured.
MAIL_FROM=""

# --- Invitations by email (optional) ---
INVITE_DAYS="14"
INVITE_KEEP_DAYS="90"

# --- The media server, for more than two people at once (optional) ---
# Without it browsers send one copy of everything to every listener, and a
# screen share multiplies with the audience until the voice falls behind.
# deploy.sh starts the server when LIVEKIT_API_KEY is set. Open 7882/udp.
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
# The public address to invite browsers to. Required: inside a container the
# server only knows a 172.x address of its own. It can ask STUN instead
# (LIVEKIT_USE_STUN=true), but a host that blocks outbound UDP leaves that
# question unanswered and LiveKit then refuses to start at all.
LIVEKIT_NODE_IP=""
# Media ports. Defaults are 7882/udp and 7881/tcp; set the UDP one to 443 where
# a firewall passes only well-known ports (it does not collide with TCP 443).
LIVEKIT_UDP_PORT=""
LIVEKIT_TCP_PORT=""

# --- Meeting recordings (optional) ---
# Each browser records its own microphone only, so consent is per person and a
# refusal costs that person's voice rather than their seat in the meeting.
# The audio is the risky artefact and the notes are the useful one, so they are
# kept for different lengths of time on purpose.
#
# RECORDING_CONSENT decides whether each person is asked or the room is told.
#   ask     (default) a sheet with the facts, a yes or a no, and only a yes is
#           recorded. The careful setting, and the one to keep unless the
#           question has been settled somewhere other than this system.
#   notice  the room is told loudly that recording has started and every
#           microphone in it records, with no sheet in the way.
# Neither setting changes the three things that are structural rather than
# configurable: no device records anybody but its owner, the red chip stays up
# for as long as it runs, and whoever's voice it is can delete it afterwards.
RECORDING_CONSENT="ask"
RECORDING_AUDIO_DAYS="7"
RECORDING_TEXT_DAYS="180"
RECORDING_MAX_MINUTES="240"

# --- Turning a recording into a summary (optional) ---
# Both are ordinary OpenAI-shaped endpoints, so what serves them is a choice
# rather than a rewrite: faster-whisper-server or whisper.cpp for the first,
# Ollama for the second. Point them at whatever machine has the room — this one
# also carries other services, and a model does not belong beside them.
# Unset means recordings are still made and simply not summarised.
ASR_URL=""                 # e.g. http://10.0.0.9:8000
ASR_MODEL="typhoon-asr-realtime"
ASR_LANG="th"
LLM_URL=""                 # e.g. http://10.0.0.9:11434
LLM_MODEL="scb10x/llama3.2-typhoon2-1b-instruct"
LLM_API_KEY=""

# --- Room bookings (optional) ---
BOOKING_MAX_MINUTES="480"
BOOKING_MAX_DAYS="90"
BOOKING_KEEP_DAYS="120"

# --- Writing bookings into people's own Google Calendars (optional) ---
# Uses the same GOOGLE_CLIENT_ID/SECRET as sign-in, so there is nothing new to
# create — but the Google Cloud project needs two more things:
#   1. Google Calendar API enabled (APIs & Services > Library)
#   2. this redirect URI added to the OAuth client:
#        https://<your host>/auth/google/calendar/callback
# The scope asked for is calendar.events, which can write events and read
# nothing else. Each person connects their own account and can disconnect it.
#
# The callback is built from APP_URL, so make sure that is set and that what is
# registered with Google matches it exactly — scheme included. Deriving it from
# the request headers is what this used to do, and behind two proxies it came
# out as http:// on an https site: Google refuses that with
# redirect_uri_mismatch while both sides look perfectly configured.
#
# GCAL_REDIRECT_URL only for a deployment where the callback is not on the same
# origin as the app.
GCAL_REDIRECT_URL=""

# --- Writing bookings into people's own Outlook calendars (optional) ---
# A separate app registration from Google's, in the Azure portal:
#   1. Entra ID (Azure AD) > App registrations > New registration
#   2. Redirect URI (type Web):
#        https://<your host>/auth/microsoft/calendar/callback
#   3. Certificates & secrets > New client secret > copy the VALUE (not the id)
#   4. API permissions > Microsoft Graph > Delegated:
#        Calendars.ReadWrite, offline_access, User.Read
# MS_TENANT decides who may sign in: "common" takes both work and personal
# accounts, "organizations" only work ones, and a tenant id only that company.
# Unset means bookings reach Outlook only through the subscribed feed.
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""
MS_TENANT="common"
MS_REDIRECT_URL=""        # only if the callback is not on the same origin as the app
