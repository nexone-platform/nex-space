# Copy to apps/api/.env for local development (docker-compose sets these itself).
# Prisma resolves a relative SQLite path against the schema folder, so this
# lands at apps/api/prisma/dev.db. The Prisma CLI reads DATABASE_URL from here.
DATABASE_URL="file:./dev.db"

# --- Google sign-in (optional) ---
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3001/auth/google/callback   (dev)
#                          https://<your-host>/auth/google/callback     (prod)
# Leave blank and the "Continue with Google" button hides itself.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- SMTP for the 6-digit sign-in code (optional) ---
# Leave blank and codes are printed to the API log instead of emailed.
# Gmail needs an App Password (not your normal password).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="NexSpace <no-reply@example.com>"
