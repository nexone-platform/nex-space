# LiveKit SFU (optional). Leave unset to use P2P mesh (no media server needed).
# Local dev: run  `docker run --rm -p 7880:7880 -p 7881:7881 -p 7882:7882/udp livekit/livekit-server --dev`
# which uses these dev credentials:
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
